---
import Layout from '../layouts/Layout.astro';
import {getCollection,render} from 'astro:content';
import {releasedProducts as products,publicCatalog,hasMacApps} from '../lib/catalog.mjs';
import SoftwareCatalog from '../components/SoftwareCatalog.astro';
import SupportNote from '../components/SupportNote.astro';
import {categories,published,seriesEntries,validateArchive,validateProducts,validateRoutes,related} from '../lib/archive.mjs';
export async function getStaticPaths(){
 validateProducts(products);const journal=published(await getCollection('journal'));const music=published(await getCollection('music'));validateArchive([...journal,...music],publicCatalog,music);validateRoutes(journal,music);
 const fixed=['music','journal','journal/series','software','software/audio-plugins','software/downloads','software/manuals','software/release-notes','software/beta-testing','support','about',...Object.keys(categories).map(k=>'journal/category/'+k)];
 if(hasMacApps)fixed.push('software/macos-apps');
 const dynamic=[...journal.map(e=>'journal/'+e.id),...music.map(e=>'music/'+e.id),...products.map(p=>'software/'+p.id),...products.flatMap(p=>['manual','release-notes','beta-testing'].map(s=>'software/'+p.id+'/'+s)),...[...new Set(journal.flatMap(e=>e.data.tags))].map(t=>'journal/tag/'+encodeURIComponent(t)),...[...new Set(journal.map(e=>e.data.series).filter(Boolean))].map(s=>'journal/series/'+s)];
 return [...fixed,...dynamic].map(path=>({params:{path},props:{journal,music}}));
}
const {journal,music}=Astro.props;const path=Astro.params.path;const u=(p='')=>import.meta.env.BASE_URL+p+'/';
const entry=journal.find(e=>path==='journal/'+e.id)||music.find(e=>path==='music/'+e.id);const product=products.find(p=>path==='software/'+p.id||path.startsWith('software/'+p.id+'/'));const part=path.split('/').at(-1);
const category=path.startsWith('journal/category/')?part:undefined;const tag=path.startsWith('journal/tag/')?decodeURIComponent(part):undefined;const sid=path.startsWith('journal/series/')?part:undefined;
const series=sid?seriesEntries(journal,sid):[];const peers=entry?.data.series?seriesEntries(journal,entry.data.series):[];const pos=entry?peers.findIndex(e=>e.id===entry.id):-1;
const title=entry?.data.seo_title||entry?.data.title||product?.title||(category?categories[category]:tag?'Tag: '+tag:sid?(series[0]?.data.series_title||sid):({'music':'Music','journal':'Journal','journal/series':'Study Series','software':'Software','software/audio-plugins':'Audio Plugins','software/macos-apps':'macOS Apps','software/downloads':'Downloads','software/manuals':'Manuals','software/release-notes':'Release Notes','software/beta-testing':'Beta Testing','support':'Support','about':'About'}[path]||'Jovaris Audio'));
const description=entry?.data.description||product?.description||title+' — Jovaris Audio 음악가의 작업 공간.';
const rendered=entry?await render(entry):null;const Content=rendered?.Content;
const list=category?journal.filter(e=>e.data.category===category):tag?journal.filter(e=>e.data.tags.includes(tag)):sid?series:journal;
const chosen=path==='software/audio-plugins'?products.filter(p=>p.kind==='audio-plugins'):path==='software/macos-apps'?products.filter(p=>p.kind==='macos-apps'):products;
---
<Layout title={title} description={description} canonical={entry?.data.canonical}><p class="eyebrow">Jovaris Audio / {path.startsWith('journal')?'Journal':path.startsWith('music')?'Music':path.startsWith('software')?'Software':'Jovaris'}</p><div class="page-title-row"><h1>{title}</h1>{product?.icon&&<img class="plugin-page-logo" src={u(product.icon).slice(0,-1)} alt={product.title+' 심벌'} width="56" height="56"/>}</div>
{entry&&<article class="article"><p class="meta">{entry.data.date.toISOString().slice(0,10)}{entry.data.series&&<> · <a href={u('journal/series/'+entry.data.series)}>{entry.data.series_title||entry.data.series}</a> #{String(entry.data.series_number).padStart(3,'0')}</>}</p><p class="lead">{description}</p>{entry.data.cover&&<img src={entry.data.cover.startsWith('/')?u(entry.data.cover.slice(1)).slice(0,-1):entry.data.cover} alt={entry.data.cover_alt}/>}<Content/>{entry.data.streaming?.map(s=><p><a href={s.url}>{s.label} ↗</a></p>)}<div class="filters">{entry.data.tags.map(t=>path.startsWith('journal/')?<a href={u('journal/tag/'+encodeURIComponent(t))}>{t}</a>:<span class="tag">{t}</span>)}</div>{entry.data.related_products.some(id=>products.some(p=>p.id===id))&&<section><h2>관련 도구</h2>{entry.data.related_products.filter(id=>products.some(p=>p.id===id)).map(id=><p><a href={u('software/'+id)}>{products.find(p=>p.id===id)?.title}</a></p>)}</section>}{entry.data.related_music.length>0&&<section><h2>관련 음악</h2>{entry.data.related_music.map(id=><p><a href={u('music/'+id)}>{music.find(m=>m.id===id)?.data.title}</a></p>)}</section>}{peers.length>0&&<nav class="pagination" aria-label="시리즈 이전 다음 글">{peers[pos-1]&&<a href={u('journal/'+peers[pos-1].id)}>← #{String(peers[pos-1].data.series_number).padStart(3,'0')} {peers[pos-1].data.title}</a>}{peers[pos+1]&&<a href={u('journal/'+peers[pos+1].id)}>#{String(peers[pos+1].data.series_number).padStart(3,'0')} {peers[pos+1].data.title} →</a>}</nav>}{path.startsWith('journal/')&&<section class="section"><h2>관련 글</h2>{related(journal,entry).map(e=><p><a href={u('journal/'+e.id)}>{e.data.title}</a></p>)}</section>}{path.startsWith('music/')&&<section class="section"><h2>관련 작업기 · 믹싱기</h2>{journal.filter(e=>e.data.related_music.includes(entry.id)).map(e=><p><a href={u('journal/'+e.id)}>{e.data.title}</a></p>)}</section>}</article>}
{!entry&&path.startsWith('journal')&&<><p class="lead">제작과 연습, 청취와 개발 과정에서 남긴 기록.</p>{path==='journal'&&<div class="journal-categories">{Object.entries(categories).map(([id,name],i)=><a href={u('journal/category/'+id)}><span class="eyebrow">{String(i+1).padStart(2,'0')} / {name}</span><p>{({'studio-journal':'작업실과 음악 제작의 기록','study-notes':'연습과 공부, 연구의 기록','listening-notes':'음악을 듣고 남긴 생각들','development-log':'앱과 플러그인을 만드는 과정'})[id]}</p></a>)}</div>}<div class="filters">{Object.entries(categories).map(([id,name])=><a href={u('journal/category/'+id)}>{name}</a>)}<a href={u('journal/series')}>책별 시리즈</a></div>{path==='journal/series'?<>{[...new Set(journal.map(e=>e.data.series).filter(Boolean))].map(s=><article class="card"><h3><a href={u('journal/series/'+s)}>{journal.find(e=>e.data.series===s)?.data.series_title||s}</a></h3><p>{seriesEntries(journal,s).length}편</p></article>)}{!journal.some(e=>e.data.series)&&<p class="empty">공개된 학습 시리즈가 아직 없습니다.</p>}</>:<><label for="search">기록 검색 — 제목, 본문, 태그</label><input id="search" type="search" placeholder="검색어를 입력하세요"/><p id="search-status" class="meta" role="status" aria-live="polite">{list.length}편의 기록</p><div class="grid journal-list" id="results">{list.map(e=><article class="card" data-search={[e.data.title,e.body,e.data.description,...e.data.tags].join(' ').toLowerCase()}><p class="meta">{categories[e.data.category]} · {e.data.date.toISOString().slice(0,10)}</p><h3><a href={u('journal/'+e.id)}>{e.data.series&&'#'+String(e.data.series_number).padStart(3,'0')+' '}{e.data.title}</a></h3><p>{e.data.description}</p></article>)}</div><p class="empty" id="no-results" hidden={list.length>0}>표시할 기록이 없습니다.</p></>}</>}
{path==='music'&&<><section class="music-hero" style={{backgroundImage:`url(${u('images/jovaris-channel.png').slice(0,-1)})`}} aria-label="Jovaris Audio 황혼 이미지"><div><p class="eyebrow">Music</p><h2>듣고, 연주하고,<br/>다시 돌아오는 음악.</h2><p>자작곡, 발표 음악, 그리고 오래 듣고 싶은 플레이리스트.</p></div></section>{music.some(m=>m.data.type!=='playlist')&&<section class="section"><h2>Featured Music</h2>{music.filter(m=>m.data.type!=='playlist').slice(0,1).map(m=><article class="card featured-music">{m.data.cover&&<img class="music-cover" src={m.data.cover.startsWith('/')?u(m.data.cover.slice(1)).slice(0,-1):m.data.cover} alt={m.data.cover_alt}/>}<h3><a href={u('music/'+m.id)}>{m.data.title}</a></h3><p>{m.data.description}</p></article>)}</section>}{music.some(m=>m.data.type==='playlist')&&<section class="section"><h2>Playlists</h2><div class="grid music-grid">{music.filter(m=>m.data.type==='playlist').map(m=><article class="card">{m.data.cover&&<img class="music-cover" src={m.data.cover.startsWith('/')?u(m.data.cover.slice(1)).slice(0,-1):m.data.cover} alt={m.data.cover_alt} loading="lazy"/>}<h3><a href={u('music/'+m.id)}>{m.data.title}</a></h3><p>{m.data.tags.join(' · ')}</p></article>)}</div></section>}<h2>Music Archive</h2><div class="filters">{[['all','전체'],['original','자작곡'],['release','발표 음악'],['playlist','플레이리스트']].map(([id,label])=><button type="button" data-music-filter={id} aria-pressed={id==='all'}>{label}</button>)}</div><div class="grid music-grid">{music.map(m=><article class="card" data-music-type={m.data.type}>{m.data.cover&&<img class="music-cover" src={m.data.cover.startsWith('/')?u(m.data.cover.slice(1)).slice(0,-1):m.data.cover} alt={m.data.cover_alt} loading="lazy"/>}<h3><a href={u('music/'+m.id)}>{m.data.title}</a></h3><p>{m.data.description}</p><p class="meta">{m.data.tags.join(' · ')}</p></article>)}</div>{!music.length&&<p class="empty">공개 준비가 끝난 음악부터 기록합니다.</p>}</>}
{product&&<><p class="lead">{product.description}</p><p class="notice">Free · {product.version}</p><div class="filters"><a href={u('software/'+product.id)}>제품 소개</a>{product.manual&&<a href={u('software/'+product.id+'/manual')}>Manual</a>}{product.release&&<a href={u('software/'+product.id+'/release-notes')}>Release Notes</a>}</div>{part==='manual'?<section class="article"><h2>설치 및 사용 안내</h2><p>{product.manual}</p></section>:part==='release-notes'?<section class="article"><h2>{product.version}</h2><p>{product.release}</p></section>:<><section class="section"><h2>스크린샷</h2>{product.screenshots.map(s=><img class="product-image" src={u(s.src.slice(1)).slice(0,-1)} alt={s.alt} loading="lazy"/>)}</section>{product.features?.length>0&&<section class="section"><h2>기능</h2><ul>{product.features.map(f=><li>{f}</li>)}</ul></section>}<section class="section"><h2>지원 플랫폼 및 포맷</h2><p>{product.platforms.map(x=>x.os+' · '+x.formats.join(' / ')).join(' · ')}</p></section>{product.issues?.length>0&&<section class="section"><h2>알려진 문제</h2><ul>{product.issues.map(i=><li>{i}</li>)}</ul></section>}<section class="section"><h2>Free Download</h2><a class="button" href={product.download.url}>Free Download · {product.version}</a><p>SHA-256: <code style="overflow-wrap:anywhere">{product.download.sha256}</code></p></section></>}</>}
{product&&<SupportNote/>}
{!product&&path.startsWith('software')&&<SoftwareCatalog kind={path==='software/macos-apps'?'macos-apps':undefined}/>}
{path==='support'&&<section class="article"><p class="lead">처음부터 무료로.</p><p>초기 모든 제품은 무료로 제공하며, 후원 여부에 따른 기능 제한은 없습니다.</p><SupportNote/><p>결제는 외부 후원 서비스에서 처리하며 이 사이트는 결제 정보를 수집하지 않습니다.</p></section>}
{path==='about'&&<section class="article"><p class="lead">Jovaris Audio는 음악가의 작업 공간입니다.</p><p>작곡과 믹싱, 음악 연구와 연습, 청취와 오디오 도구 개발을 하나의 이름 아래 기록합니다. 실제 작업에서 출발한 경험과 결과를 차곡차곡 남깁니다.</p><p>음악과 개발이 서로를 돕고, 기록이 실제 작업을 방해하지 않는 운영을 지향합니다.</p></section>}
</Layout>
<script>
 const search=document.querySelector<HTMLInputElement>('#search');const cards=[...document.querySelectorAll<HTMLElement>('[data-search]')];search?.addEventListener('input',()=>{const q=search.value.toLowerCase().trim();let count=0;cards.forEach(c=>{c.hidden=!c.dataset.search?.includes(q);if(!c.hidden)count++});document.querySelector('#search-status')!.textContent=count+'편의 기록';(document.querySelector('#no-results') as HTMLElement).hidden=count>0;});
 document.querySelectorAll<HTMLButtonElement>('[data-music-filter]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-music-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.querySelectorAll<HTMLElement>('[data-music-type]').forEach(c=>c.hidden=b.dataset.musicFilter!=='all'&&c.dataset.musicType!==b.dataset.musicFilter);}));
</script>
