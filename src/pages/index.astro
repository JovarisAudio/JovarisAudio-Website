---
import Layout from '../layouts/Layout.astro';
import {getCollection} from 'astro:content';
import {published} from '../lib/archive.mjs';
import products from '../data/products.json';
const posts=published(await getCollection('journal')).slice(0,3);const music=published(await getCollection('music')).slice(0,2);const u=(p='')=>import.meta.env.BASE_URL+p;
---
<Layout><section class="hero-banner recomposed" aria-label="Jovaris Audio — 황혼의 도시와 오른쪽 산에서 바위를 밀어 올리는 사람" style={{backgroundImage:`url(${u('images/jovaris-hero-v4-balanced.png')})`}}><div class="hero-content"><div class="climb-motto"><p>Every day, we push the stone again.</p><span>MUSIC FOR THE CLIMB.</span></div><h1>오늘도, 계속하는 일에 관하여.</h1><p class="hero-description">음악을 만들고, 다시 배웁니다.<br/>듣고, 연주하고, 생각하고,<br class="mobile-break"/> 그 과정들을 기록합니다.</p><p class="hero-secondary">작곡과 믹싱, 연습과 감상.<br/>그리고 작업에서 시작된 작은 도구들.</p><div class="hero-action"><a class="button" href={u('music/')}>Explore Music</a></div></div><p class="art-quote centered-quote">Sound that moves forward.<br/>Again and again.</p></section><section class="section home-music-panel" style={{'--music-landscape':`url(${u('images/music-landscape-clean.png')})`,'--music-waveform':`url(${u('images/music-waveform.svg')})`}}><div class="section-head"><h2>Music</h2><div class="music-section-links"><img class="music-link-waveform" src={u('images/music-waveform.svg')} alt="" width="160" height="40"/><a href={u('music/')}>모든 음악 →</a></div></div><div class="music-landscape-motto"><p>Every day, we push the stone again.</p><span>MUSIC FOR THE CLIMB.</span></div>{music.length?music.map(m=><article class="card"><h3><a href={u('music/'+m.id+'/')}>{m.data.title}</a></h3><p>{m.data.description}</p></article>):null}</section><section class="section"><div class="section-head"><h2>Journal</h2><a href={u('journal/')}>작업 기록 →</a></div>{posts.length?posts.map(e=><article class="card"><p class="meta">{e.data.date.toISOString().slice(0,10)}</p><h3><a href={u('journal/'+e.id+'/')}>{e.data.title}</a></h3><p>{e.data.description}</p></article>):<p class="empty">작업과 연습, 연구와 청취의 기록.</p>}</section><section class="section home-software-panel" style={{backgroundImage:`url(${u('images/software-collage.webp')})`}}><div class="section-head"><div><p class="eyebrow">Built for the studio</p><h2>Software</h2></div><a href={u('software/')}>도구 살펴보기 →</a></div><div class="grid">{products.map(p=><article class="card home-product-card">{p.icon&&<img class="plugin-corner-logo" src={u(p.icon)} alt={p.title+' 아이콘'} width="36" height="36" loading="lazy"/>}<p class="eyebrow">{p.kind==='audio-plugins'?'Audio Plugins':'macOS Apps'} · {p.status}</p><h3><a href={u('software/'+p.id+'/')}>{p.title}</a></h3><p>{p.description}</p></article>)}</div></section><section class="section"><h2>최근 업데이트</h2><p>소프트웨어의 현재 버전과 테스트 상태는 각 제품 페이지에서 확인할 수 있습니다.</p><a href={u('software/release-notes/')}>Release Notes →</a></section><section class="section"><h2>작업을 응원하고 싶다면</h2><p>이곳의 음악과 작은 도구들이 마음에 드셨다면,<br/>보내주시는 응원에 감사하겠습니다.</p><a href={u('support/')}>후원 안내 →</a></section></Layout>
