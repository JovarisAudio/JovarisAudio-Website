---
import '../styles/global.css';
import '../styles/ui-refresh.css';
import {t,localizedPath} from '../lib/i18n.mjs';
import SupportNote from '../components/SupportNote.astro';
const {title='Jovaris Audio',description='음악·청취·연구와 창작 과정에서 직접 만든 도구를 위한 공간.',canonical,locale='en',alternates,isContent=false,noindex=false}=Astro.props;
const base=import.meta.env.BASE_URL;
const logical=Astro.url.pathname.slice(base.length).replace(/^ko\//,'');
const section=logical.startsWith('journal')?'journal':logical.startsWith('music')?'music':logical.startsWith('software')?'software':'home';
const url=(p='')=>localizedPath(p,locale,base);
const translations=alternates||{en:logical,ko:'ko/'+logical};
const canonicalURL=Astro.site&&!noindex?new URL(Astro.url.pathname,Astro.site).href:undefined;
const hrefFor=l=>translations[l]!==undefined?base+translations[l]:localizedPath(logical.startsWith('journal/')?'journal/':logical.startsWith('music/')?'music/':'',l,base);
const metaTitle=isContent?title:t(title,locale);
const metaDescription=isContent?description:t(description,locale);
---
<!doctype html><html lang={locale} data-ui-language={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title data-content>{metaTitle} · JOVARIS AUDIO</title><meta name="description" content={metaDescription} data-content/>{canonicalURL&&<link rel="canonical" href={canonicalURL}/>}<meta name="robots" content={Astro.site&&!noindex?'index,follow':'noindex,nofollow'}/>{Astro.site&&Object.entries(translations).map(([language,path])=><link rel="alternate" hreflang={language} href={new URL(base+path,Astro.site).href}/>)}{Astro.site&&translations.en&&<link rel="alternate" hreflang="x-default" href={new URL(base+translations.en,Astro.site).href}/>}<meta property="og:title" content={metaTitle} data-content/><meta property="og:description" content={metaDescription} data-content/><meta property="og:locale" content={locale==='ko'?'ko_KR':'en_US'}/><meta property="og:type" content={isContent?'article':'website'}/>{canonicalURL&&<meta property="og:url" content={canonicalURL}/>}<meta name="theme-color" content="#fafafa"/><link rel="icon" href={base+'favicon.ico'} sizes="any"/><link rel="icon" href={base+'favicon-32x32.png'} type="image/png" sizes="32x32"/><link rel="apple-touch-icon" href={base+'apple-touch-icon.png'}/>{canonical&&<meta name="citation_url" content={canonical}/>}</head><body class={'page-'+section}><a class="skip" href="#main">본문으로 이동</a><header><a class="brand" href={url()}><img class="brand-mark" src={base+'images/ja-symbol.webp'} alt="" width="36" height="36"/><span class="brand-name">JOVARIS <span class="brand-audio">AUDIO</span></span></a><nav aria-label="주 메뉴">{['Home','Music','Journal','Software'].map((label,i)=><a href={url(i?label.toLowerCase()+'/':'')} aria-current={(i===0?!logical:logical.startsWith(label.toLowerCase()+'/'))?'page':undefined}>{label}</a>)}</nav><div class="language-switch" role="group" aria-label="Language"><a href={hrefFor('en')} data-language="en" aria-current={locale==='en'?'true':undefined}>EN</a><span aria-hidden="true">/</span><a href={hrefFor('ko')} data-language="ko" aria-current={locale==='ko'?'true':undefined}>한국어</a></div></header><main id="main"><slot/></main><footer><div><div class="footer-brand"><img src={base+'images/ja-symbol.webp'} alt="JA 심벌" width="40" height="40" loading="lazy"/><strong>JOVARIS AUDIO</strong></div><p>{locale==='ko'?'음악과 청취, 연구와 창작 과정에서':'A place for music, listening, research,'}<br/>{locale==='ko'?'직접 만든 도구를 위한 공간.':'and tools built from creative practice.'}</p><SupportNote compact locale={locale}/></div><div><a href={url('music/')}>Music</a><a href={url('journal/')}>Journal</a><a href={url('software/')}>Software</a><a href={url('about/')}>About</a><a href={url('support/')}>Support</a><p>© 2026 Jovaris Audio / WH</p></div></footer></body></html>
<script>
const base=import.meta.env.BASE_URL;
document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(link=>link.addEventListener('click',()=>{try{localStorage.setItem('jovaris-language',link.dataset.language!)}catch{}}));
// Explicit locale URLs are authoritative. Only remember a deliberate Home preference.
if(location.pathname===base){try{if(localStorage.getItem('jovaris-language')==='ko')location.replace(base+'ko/'+location.search+location.hash)}catch{}}
</script>
