---
import '../styles/global.css';
import '../styles/ui-refresh.css';
const {title='Jovaris Audio',description='음악을 만들고, 듣고, 연구하는 작업 공간. 음악 제작과 믹싱, 오디오 도구 개발의 기록.',canonical}=Astro.props;
const section=Astro.url.pathname.includes('/journal')?'journal':Astro.url.pathname.includes('/music')?'music':Astro.url.pathname.includes('/software')?'software':'home';
const base=import.meta.env.BASE_URL;const url=(p='')=>base+p;
const canonicalURL=canonical || (Astro.site ? new URL(Astro.url.pathname,Astro.site).href : undefined);

---
<!doctype html><html lang="ko"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} · JOVARIS AUDIO</title><meta name="description" content={description}/>{canonicalURL&&<link rel="canonical" href={canonicalURL}/>}<meta name="robots" content={Astro.site?'index,follow':'noindex,nofollow'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{canonicalURL&&<meta property="og:url" content={canonicalURL}/>}<meta name="theme-color" content="#fafafa"/><link rel="icon" href={url('favicon.ico')} sizes="any"/><link rel="icon" href={url('favicon-32x32.png')} type="image/png" sizes="32x32"/><link rel="apple-touch-icon" href={url('apple-touch-icon.png')}/></head><body class={'page-'+section}><a class="skip" href="#main">본문으로 이동</a><header><a class="brand" href={url()}><img class="brand-mark" src={url('images/ja-symbol.webp')} alt="" width="36" height="36"/><span class="brand-name">JOVARIS <span class="brand-audio">AUDIO</span></span></a><nav aria-label="주 메뉴">{['Home','Music','Journal','Software'].map((label,i)=><a href={url(i?label.toLowerCase()+'/':'')} aria-current={(i===0?Astro.url.pathname===base:Astro.url.pathname.startsWith(url(label.toLowerCase()+'/')))?'page':undefined}>{label}</a>)}</nav></header><main id="main"><slot/></main><footer><div><div class="footer-brand"><img src={url('images/ja-symbol.webp')} alt="JA 심벌" width="40" height="40" loading="lazy"/><strong>JOVARIS AUDIO</strong></div><p>음악가의 작업 공간.</p></div><div><a href={url('about/')}>About</a><a href={url('support/')}>Support</a><a href={url('software/downloads/')}>Downloads</a><p>© 2026 Jovaris Audio / WH</p></div></footer></body></html>
