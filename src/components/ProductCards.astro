---
const {products}=Astro.props;const u=p=>import.meta.env.BASE_URL+p+'/';
---
<div class="grid product-grid available-grid">{products.map(p=><article class="card product-card available-card"><img class="product-image" src={import.meta.env.BASE_URL+p.screenshots[0].src.slice(1)} alt={p.screenshots[0].alt} loading="lazy"/><h3><a href={u('software/'+p.id)}>{p.title}</a></h3><p>{p.description}</p><p class="meta">{p.platforms.map(x=>x.os+' · '+x.formats.join(' / ')).join(' · ')} · {p.version}</p><a class="button" href={p.download.url}>Free Download</a><a class="details-link" href={u('software/'+p.id)}>View Details →</a></article>)}</div>
