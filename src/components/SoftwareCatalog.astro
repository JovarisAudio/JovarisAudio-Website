---
import { releasedProducts, previewProducts, hasMacApps } from '../lib/catalog.mjs';
import { tuck } from '../data/tuck.mjs';
import { localizedPath } from '../lib/i18n.mjs';
import ProductCards from './ProductCards.astro';
import SoftwareIntro from './SoftwareIntro.astro';
import SupportNote from './SupportNote.astro';

const { kind, showTuck, locale = 'en' } = Astro.props;
const ko = locale === 'ko';
const base = import.meta.env.BASE_URL;
const url = (path) => localizedPath(path, locale, base);
const audio = releasedProducts.filter(p => p.kind === 'audio-plugins');
const apps = releasedProducts.filter(p => p.kind === 'macos-apps');
---
{showTuck && !kind && <SoftwareIntro {locale}/>}
{!kind && (audio.length > 0 || hasMacApps) && <div class="filters">
  {audio.length > 0 && <a href={url('software/audio-plugins')}>Audio Plugins</a>}
  {hasMacApps && <a href={url('software/macos-apps')}>macOS Apps</a>}
</div>}
{kind !== 'macos-apps' && (audio.length > 0 || !showTuck) && <section class="section available-section">
  <h2>{locale === 'ko' ? '다운로드 가능' : 'Available'}</h2>
  {audio.length > 0 ? <ProductCards products={audio} {locale}/> :
    <p class="empty">현재 공개 다운로드가 제공되는 제품은 없습니다.</p>}
</section>}
{showTuck && <section class="section macos-collection">
  <h2>{kind ? (ko ? '제품 목록' : 'Apps') : 'macOS Apps'}</h2>
  <ProductCards products={apps} {locale}>
    <article class="card product-card app-announcement" data-content>
      <img class="product-image" src={base + tuck.cover} alt="" loading="lazy"/>
      <h3><a href={url(tuck.path)}>{tuck.name}</a></h3>
      <p>{tuck[locale].description}</p>
      <p class="meta">{tuck[locale].platform} · {tuck.version}</p>
      <a class="button" href={tuck.downloads.dmg}>{tuck[locale].downloadButton} · {tuck.version}</a>
      <a class="details-link" href={url(tuck.path)}>{ko ? '자세히 보기' : 'View details'} →</a>
    </article>
  </ProductCards>
</section>}
{!kind && previewProducts.length > 0 && <section class="section preview-section">
  <h2>In the Works</h2>
  <div class="preview-grid">{previewProducts.map(p => <article class="preview-item">
    {p.icon && <img src={base + p.icon} alt="" width="40" height="40" loading="lazy"/>}
    <h3 data-official-name>{p.title}</h3>
  </article>)}</div>
</section>}
<SupportNote {locale}/>
