---
import Layout from '../layouts/Layout.astro';
import {siteData} from '../lib/site-routes.mjs';
import {entryInLanguage} from '../lib/content-language.mjs';
import {localizedPath} from '../lib/i18n.mjs';
const {locale='en'}=Astro.props;
const {journal,music:musicEntries,journalIndex,musicIndex}=await siteData();
import {published} from '../lib/archive.mjs';
import {releasedProducts as products} from '../lib/catalog.mjs';
import ProductCards from '../components/ProductCards.astro';
import SupportNote from '../components/SupportNote.astro';
const posts=[...journal].sort((a,b)=>Number(b.data.curated)-Number(a.data.curated)).slice(0,3).map(e=>entryInLanguage(e,journalIndex,locale));const music=[...musicEntries].sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)).slice(0,2).map(e=>entryInLanguage(e,musicIndex,locale));const u=(p='')=>/^(images|favicon)/.test(p)?import.meta.env.BASE_URL+p:localizedPath(p,locale,import.meta.env.BASE_URL);const workURL=(kind,id)=>import.meta.env.BASE_URL+kind+'/'+id+'/';
---
<Layout locale={locale} alternates={{en:'',ko:'ko/'}}><section class="hero-banner recomposed" aria-label="Jovaris Audio — 황혼의 도시와 오른쪽 산에서 바위를 밀어 올리는 사람" style={{backgroundImage:`url(${u('images/jovaris-hero-v5-spacing.png')})`}}><div class="hero-content"><div class="climb-motto"><p>Every day, we push the stone again.</p><span>MUSIC FOR THE CLIMB.</span></div><h1>오늘도, 계속하는 일에 관하여.</h1><p class="hero-description">음악을 만들고, 다시 배웁니다.<br/>듣고, 연주하고, 생각하고,<br class="mobile-break"/> 그 과정들을 기록합니다.</p><p class="hero-secondary">작곡과 믹싱, 연습과 감상.<br/>그리고 작업에서 시작된 작은 도구들.</p><div class="hero-action brand-paths"><a class="button" href={u('music/')}>Music</a><a class="button" href={u('journal/')}>Journal</a><a class="button" href={u('software/')}>Software</a></div></div><p class="art-quote centered-quote">Sound that moves forward.<br/>Again and again.</p></section><section class="section home-music-panel" style={{'--music-landscape':`url(${u('images/music-landscape-clean.png')})`,'--music-waveform':`url(${u('images/music-waveform.svg')})`}}><div class="section-head"><h2>Music</h2><div class="music-section-links"><img class="music-link-waveform" src={u('images/music-waveform.svg')} alt="" width="160" height="40"/><a href={u('music/')}>모든 음악 →</a></div></div><div class="music-landscape-motto"><p>Every day, we push the stone again.</p><span>MUSIC FOR THE CLIMB.</span></div>{music.length?music.map(m=><article class="card"><h3><a href={workURL('music',m.id)}><span data-content>{m.data.title}</span></a></h3><p><span data-content lang={m.data.language}>{m.data.description}</span></p></article>):null}</section><section class="section"><div class="section-head"><h2>Journal</h2><a href={u('journal/')}>작업 기록 →</a></div>{posts.length?posts.map(e=><article class="card"><p class="meta">{e.data.date.toISOString().slice(0,10)} · {e.data.language==='ko'?(locale==='ko'?'원문 언어: 한국어':'Original language: Korean'):(locale==='ko'?'영어':'English')}</p><h3><a href={workURL('journal',e.id)}><span data-content>{e.data.title}</span></a></h3><p><span data-content lang={e.data.language}>{e.data.description}</span></p></article>):<p class="empty">작업과 연습, 연구와 청취의 기록.</p>}</section><section class="section home-software-panel"><div class="section-head"><div><p class="eyebrow">Built for the studio</p><h2>Software</h2></div><a href={u('software/')}>오디오 플러그인을 살펴보세요. →</a></div><p class="software-intro">창작 과정에서 직접 만든 도구.</p>{products.length>0&&<p>초기 모든 제품은 무료로 제공하며, 후원 여부에 따른 기능 제한은 없습니다.</p>}{products.length>0&&<ProductCards products={products.filter(p=>p.kind==='audio-plugins')} locale={locale}/>}</section><section class="section"><h2>작업을 응원하고 싶다면</h2><p>이곳의 음악과 작은 도구들이 마음에 드셨다면,<br/>보내주시는 응원에 감사하겠습니다.</p><SupportNote locale={locale} intro={false}/></section></Layout>
